#!/usr/bin/env bash
# bin/gargamelle-tagref — Mechanical Tagref Cross-Reference Verification Harness
# Enforces:
#   - 0 duplicate tag definitions across repository
#   - 0 dangling reference pointers
#   - 0 orphaned tags without references
#
# Delegates to the native `tagref` binary when available, falling back to
# a deterministic internal Python validator when running in minimal environments.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

run_native_tagref() {
  (cd "${REPO_ROOT}" && tagref "$@")
}

run_python_fallback() {
  REPO_ROOT="${REPO_ROOT}" python3 - <<'EOF'
import sys, os, re, subprocess

repo_root = os.environ.get("REPO_ROOT", os.getcwd())

# Parse tagref.yml ignore rules
ignore_rules = []
cfg_file = os.path.join(repo_root, "tagref.yml")
if os.path.isfile(cfg_file):
    with open(cfg_file, "r", encoding="utf-8") as f:
        in_ignore = False
        for line in f:
            line_str = line.strip()
            if line_str.startswith("ignore_rules:"):
                in_ignore = True
                continue
            if in_ignore:
                if line_str.startswith("-"):
                    rule = line_str.lstrip("- ").strip().strip("\"'")
                    if rule:
                        ignore_rules.append(rule)
                elif line_str and not line_str.startswith("#"):
                    in_ignore = False

tag_regex = re.compile(r"\[tag:([a-zA-Z0-9_\-]+)\]")
ref_regex = re.compile(r"\[ref:([a-zA-Z0-9_\-]+)\]")

try:
    git_files = subprocess.check_output(["git", "ls-files"], cwd=repo_root, text=True).splitlines()
except Exception:
    git_files = []

tags = {}
refs = []
scanned = 0

for rel_path in git_files:
    if any(rel_path == rule or rel_path.startswith(rule.rstrip("/") + "/") for rule in ignore_rules):
        continue
    abs_path = os.path.join(repo_root, rel_path)
    try:
        with open(abs_path, "r", encoding="utf-8", errors="ignore") as fp:
            content = fp.read()
    except Exception:
        continue
    scanned += 1
    for match in tag_regex.finditer(content):
        tag = match.group(1)
        line = content[:match.start()].count("\n") + 1
        tags.setdefault(tag, []).append((rel_path, line))
    for match in ref_regex.finditer(content):
        ref = match.group(1)
        line = content[:match.start()].count("\n") + 1
        refs.append((ref, rel_path, line))

duplicates = {t: locs for t, locs in tags.items() if len(locs) > 1}
dangling = [r for r in refs if r[0] not in tags]
unused = [t for t in tags if not any(r[0] == t for r in refs)]

if duplicates or dangling:
    if duplicates:
        print("[FAIL] Duplicate tags detected:")
        for t, locs in duplicates.items():
            print(f"  [tag:{t}]:")
            for f, l in locs:
                print(f"    @ {f}:{l}")
    if dangling:
        print("[FAIL] Dangling references detected:")
        for r, f, l in dangling:
            print(f"  [ref:{r}] @ {f}:{l} has no corresponding [tag:{r}]")
    sys.exit(1)

print(f"{len(tags)} tags, 0 group members, {len(refs)} references validated in {scanned} git-tracked files (Python fallback).")
if unused:
    print(f"  [WARN] {len(unused)} unreferenced tag(s): {', '.join(unused)}")
sys.exit(0)
EOF
}

if command -v tagref >/dev/null 2>&1; then
  run_native_tagref "$@"
else
  run_python_fallback "$@"
fi
