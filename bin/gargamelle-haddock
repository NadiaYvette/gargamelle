def find_package_doc_dir(repo_root, pkg_name):
    pattern = os.path.join(repo_root, "dist-newstyle", "build", "**", f"{pkg_name}-*", "doc", "html", pkg_name)
    matches = glob.glob(pattern, recursive=True)
    if matches:
        return matches[0]
    return None

def module_to_html_filename(mod_name):
    return mod_name.replace(".", "-") + ".html"

def module_to_src_filename(mod_name):
    return "src/" + mod_name.replace("-", ".") + ".html"

def validate_haddock_trees(repo_root):
    """
    Checks that all 11 packages have complete, valid Haddock trees on disk.
    """
    missing = []
    stats = {}

    for pkg_info in PACKAGES:
        pkg_name = pkg_info["name"]
        doc_dir = find_package_doc_dir(repo_root, pkg_name)
        if not doc_dir or not os.path.isdir(doc_dir):
            missing.append(f"{pkg_name}: Documentation directory not found")
            continue

        index_file = os.path.join(doc_dir, "index.html")
        haddock_file = os.path.join(doc_dir, f"{pkg_name}.haddock")
        src_dir = os.path.join(doc_dir, "src")
        doc_index = os.path.join(doc_dir, "doc-index.html")

        if not os.path.isfile(index_file):
            missing.append(f"{pkg_name}: Missing index.html")
        if not os.path.isfile(haddock_file):
            missing.append(f"{pkg_name}: Missing {pkg_name}.haddock interface")
        if not os.path.isdir(src_dir):
            missing.append(f"{pkg_name}: Missing hyperlinked source directory (src/)")
        if not os.path.isfile(doc_index):
            missing.append(f"{pkg_name}: Missing doc-index.html")

        src_count = len(glob.glob(os.path.join(src_dir, "*.html"))) if os.path.isdir(src_dir) else 0
        stats[pkg_name] = {
            "doc_dir": doc_dir,
            "modules": len(pkg_info["modules"]),
            "source_files": src_count
        }

    return missing, stats

def run_cabal_haddock(repo_root):
    """
    Executes cabal haddock across all 11 packages, returning (success, output, warnings).
    """
    cmd = [
        "cabal", "haddock",
        *[pkg["name"] for pkg in PACKAGES],
        "--haddock-hyperlink-source",
        "--haddock-quickjump"
    ]
    res = subprocess.run(cmd, cwd=repo_root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

    warnings = []
    out_of_scope_re = re.compile(r"Warning:\s+'([^']+)'\s+is out of scope")
    ambiguous_re = re.compile(r"Warning:\s+'([^']+)'\s+is ambiguous")
    unused_import_re = re.compile(r"warning:.*\[-Wunused-imports\]")

    in_gargamelle_section = True
    for line in res.stdout.splitlines():
        # Check for out-of-scope identifiers or ambiguities in Gargamelle
        m_scope = out_of_scope_re.search(line)
        if m_scope:
            sym = m_scope.group(1)
            # Filter out vendor dependencies warnings if any
            if not any(v in line for v in ("Proarrow", "Polytropos")):
                warnings.append(f"Identifier '{sym}' is out of scope in docstrings: {line.strip()}")
        m_ambig = ambiguous_re.search(line)
        if m_ambig:
            sym = m_ambig.group(1)
            warnings.append(f"Identifier '{sym}' is ambiguous in docstrings: {line.strip()}")
        if unused_import_re.search(line):
            warnings.append(f"Unused import in package module: {line.strip()}")

    success = (res.returncode == 0) and (len(warnings) == 0)
    return success, res.stdout, warnings

def assemble_unified_portal(repo_root, dest_dir, stats):
    """
    Assembles a unified multi-package API portal with hyperlinked sources in dest_dir.
    """
    os.makedirs(dest_dir, exist_ok=True)

    # Symlink package documentation trees into dest_dir
    for pkg_info in PACKAGES:
        pkg_name = pkg_info["name"]
        if pkg_name in stats and "doc_dir" in stats[pkg_name]:
            src_dir = stats[pkg_name]["doc_dir"]
            link_path = os.path.join(dest_dir, pkg_name)
            if os.path.islink(link_path) or os.path.isfile(link_path):
                os.unlink(link_path)
            elif os.path.isdir(link_path):
                shutil.rmtree(link_path)
            os.symlink(src_dir, link_path)

    # Generate unified index.html
    html = []
    html.append("<!DOCTYPE html>")
    html.append("<html lang=\"en\">")
    html.append("<head>")
    html.append("  <meta charset=\"utf-8\">")
    html.append("  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    html.append("  <title>Gargamelle — Hyperlinked Haddock Documentation Portal</title>")
    html.append("  <style>")
    html.append("""
      :root {
        --bg: #f8fafc;
