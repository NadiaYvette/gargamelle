cabal-version: 3.0
name: gargamelle-fol
version: 0.1.0.0
synopsis: First-order logic institution and streaming Z3 SMT pipe for gargamelle
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    FirstOrder
    Hyperdoctrine
    RefinementCalculus
    Gargamelle.FOL.Z3
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6,
    process >= 1.6,
    polytropos-core,
    gargamelle-core,
    gargamelle-model

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6,
    process >= 1.6,
    gargamelle-fol,
    gargamelle-core,
    gargamelle-model,
    hspec >= 2.10
