cabal-version: 3.0
name: gargamelle-fol
version: 0.1.0.0
synopsis: First-order logic institution interfacing with Folly
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple

library
  exposed-modules:
    FirstOrder
    Hyperdoctrine
    RefinementCalculus
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    polytropos-core,
    gargamelle-core,
    Folly
