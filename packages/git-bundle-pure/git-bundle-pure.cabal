cabal-version:      3.0
name:               git-bundle-pure
version:            0.1.0.0
synopsis:           Pure-Haskell Git Object Hashing, PACK v2, and gitformat-bundle(5) Codec
description:        Standalone zero-FFI implementation of Git loose object hashing, PACK v2 encoding, and gitformat-bundle(5) v2 codec.
license:            BSD-3-Clause
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Data, Development
build-type:         Simple

library
    exposed-modules:
        Data.VCS.GitBundle
    build-depends:
        base >= 4.18 && < 5,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.9,
        zlib >= 0.6 && < 0.8,
        cryptohash-sha1 >= 0.11 && < 0.12,
        base16-bytestring >= 1.0 && < 1.1
    hs-source-dirs:   src
    default-language: GHC2021
    ghc-options:      -Wall -O2

test-suite git-bundle-pure-test
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.18 && < 5,
        bytestring,
        git-bundle-pure,
        cryptohash-sha1
    default-language: GHC2021
    ghc-options:      -Wall
