cabal-version: 3.0
name: gargamelle-sheaf
version: 0.1.0.0
synopsis: Cellular sheaves, Store comonad diffusion, and homological fault localization for Gargamelle
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gargamelle.Sheaf
    Gargamelle.Sheaf.Complex
    Gargamelle.Sheaf.Diffusion
    Gargamelle.Sheaf.Cohomology
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6,
    comonad >= 5.0,
    lattices >= 2.2,
    profunctors >= 5.6,
    gargamelle-logic,
    gargamelle-model,
    gargamelle-core,
    proarrow >= 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-sheaf,
    gargamelle-logic,
    gargamelle-model,
    gargamelle-core,
    containers >= 0.6,
    lattices >= 2.2,
    comonad >= 5.0,
    proarrow >= 0.2,
    hspec >= 2.10
