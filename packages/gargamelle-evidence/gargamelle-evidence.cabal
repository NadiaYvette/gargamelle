cabal-version: 3.0
name: gargamelle-evidence
version: 0.1.0.0
synopsis: Evidence preservation and structural tree-diff AST tracking
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple

library
  exposed-modules:
    Evidence
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    unordered-containers,
    hashable,
    text,
    polytropos-core,
    gargamelle-core,
    hs-tree-sitter,
    tree-diff
