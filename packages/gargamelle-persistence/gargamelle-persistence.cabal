cabal-version: 3.0
name: gargamelle-persistence
version: 0.1.0.0
synopsis: Beam SQLite database persistence for evidence and run tracking
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Persistence.Schema
    Persistence.Beam
    Persistence.Queries
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text,
    beam-core,
    beam-sqlite,
    sqlite-simple,
    polytropos-core >= 0.1.0.1,
    gargamelle-core
