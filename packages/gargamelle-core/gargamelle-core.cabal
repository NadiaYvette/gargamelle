cabal-version: 3.0
name: gargamelle-core
version: 0.1.0.0
synopsis: Core Institution class and base logical structures for gargamelle
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple

library
  exposed-modules:
    Institution
    Propositional
    SessionTypes
    Sheaf
    CEGIS
    Core.AST
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    polytropos-core
