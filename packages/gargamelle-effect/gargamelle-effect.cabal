cabal-version: 3.0
name: gargamelle-effect
version: 0.1.0.0
synopsis: Kernmantle Arrow Rope effect orchestration layer with Polytropos O(1) routers, optics, and fusion
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Effect.Strand
    Effect.Handlers
    Effect.Rope
    Effect.Strand.Beam
    Gargamelle.Effect
    Gargamelle.Effect.Router
    Gargamelle.Effect.Optics
    Gargamelle.Effect.Fusion
    Gargamelle.Effect.Rope
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -Wno-unused-imports -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.14 && < 5,
    text,
    containers,
    primitive >= 0.8,
    profunctors >= 5.6,
    kan-extensions >= 5.2,
    polytropos-core >= 0.1.0.1,
    polytropos-plugin >= 0.1.0.1,
    polytropos-profunctors >= 0.1.0.1,
    gargamelle-core,
    gargamelle-persistence,
    kernmantle >= 0.1.0.1,
    beam-core,
    beam-sqlite,
    sqlite-simple,
    directory,
    filepath,
    process

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-effect,
    gargamelle-core,
    gargamelle-persistence,
    polytropos-core >= 0.1.0.1,
    polytropos-plugin >= 0.1.0.1,
    polytropos-profunctors >= 0.1.0.1,
    kernmantle >= 0.1.0.1,
    primitive,
    profunctors,
    kan-extensions,
    containers,
    text,
    hspec >= 2.10
