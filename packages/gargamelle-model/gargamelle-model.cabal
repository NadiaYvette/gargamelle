cabal-version: 3.0
name: gargamelle-model
version: 0.1.0.0
synopsis: Observable runtime models, free verifier ASTs, and proof-carrying satisfaction for Gargamelle
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gargamelle.Model.Satisfaction
    Gargamelle.Model.Structure
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6,
    contravariant >= 1.5,
    profunctors >= 5.6,
    indexed-profunctors >= 0.1,
    constraints >= 0.14,
    lattices >= 2.2,
    polytropos-core >= 0.1,
    gargamelle-logic

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-model,
    gargamelle-logic,
    polytropos-core,
    contravariant,
    lattices,
    hspec >= 2.10
