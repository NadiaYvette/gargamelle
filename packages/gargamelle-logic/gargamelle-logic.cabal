cabal-version: 3.0
name: gargamelle-logic
version: 0.1.0.0
synopsis: Pure syntax, defunctionalized arrows, order theory, and refinement calculi for Gargamelle
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gargamelle.Logic.Signature
    Gargamelle.Logic.Syntax
    Gargamelle.Logic.Defunctionalize
    Gargamelle.Logic.Order
    Gargamelle.Logic.Galois
    Gargamelle.Logic.Contract
    Gargamelle.Logic.Hole
    Gargamelle.Logic.MPST
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6,
    polytropos-core >= 0.1,
    lattices >= 2.2,
    constraints >= 0.14,
    profunctors >= 5.6

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-logic,
    polytropos-core,
    lattices,
    constraints,
    profunctors,
    hspec >= 2.10
