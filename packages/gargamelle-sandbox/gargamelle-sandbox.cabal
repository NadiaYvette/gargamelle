cabal-version: 3.0
name: gargamelle-sandbox
version: 0.1.0.0
synopsis: Bubblewrap namespace sandboxing and resource limit enforcement
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Sandbox.Effect
    Sandbox.Handler
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text,
    directory,
    filepath,
    process,
    polytropos-core >= 0.1.0.1,
    gargamelle-core
