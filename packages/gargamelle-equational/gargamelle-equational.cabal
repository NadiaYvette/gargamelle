cabal-version: 3.0
name: gargamelle-equational
version: 0.1.0.0
synopsis: Equational logic institution interfacing with Jukebox
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple

library
  exposed-modules:
    Equational
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    gargamelle-core,
    jukebox
