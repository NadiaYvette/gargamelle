cabal-version: 3.0
name: gargamelle-workflow
version: 0.1.0.0
synopsis: Synthesis workflow, Crem state machine, and end-to-end integration
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Workflow.Synthesis
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text,
    containers,
    tree-diff,
    crem,
    singletons-base,
    polytropos-core,
    gargamelle-core,
    gargamelle-evidence,
    gargamelle-effect,
    gargamelle-persistence,
    gargamelle-sandbox,
    gargamelle-sheaf,
    gargamelle-model,
    gargamelle-logic,
    sqlite-simple,
    beam-core,
    beam-sqlite,
    lattices

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-core,
    gargamelle-fol,
    gargamelle-equational,
    gargamelle-evidence,
    gargamelle-effect,
    gargamelle-persistence,
    gargamelle-sandbox,
    gargamelle-sheaf,
    gargamelle-model,
    gargamelle-logic,
    gargamelle-workflow,
    hspec,
    text,
    containers,
    beam-core,
    beam-sqlite,
    sqlite-simple,
    crem,
    directory,
    filepath,
    process,
    tree-diff,
    lattices

