cabal-version: 3.0
name: gargamelle-workflow
version: 0.1.0.0
synopsis: Synthesis workflow, Crem state machine, and end-to-end integration
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple

library
  exposed-modules:
    Workflow.Synthesis
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text,
    containers,
    tree-diff,
    crem,
    singletons-base,
    polytropos-core,
    gargamelle-core,
    gargamelle-evidence,
    gargamelle-effect,
    gargamelle-persistence,
    gargamelle-sandbox

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-core,
    gargamelle-fol,
    gargamelle-equational,
    gargamelle-evidence,
    gargamelle-effect,
    gargamelle-persistence,
    gargamelle-sandbox,
    gargamelle-workflow,
    hspec,
    text,
    beam-core,
    beam-sqlite,
    sqlite-simple,
    crem,
    directory,
    filepath,
    process,
    tree-diff
