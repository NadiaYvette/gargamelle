cabal-version:       3.0
name: gargamelle
version:             0.1.0.0
synopsis:            Haskell library and toolkit for autonomous programming at large scale
description:         Provides an Institution framework with instances for first-order logic, equational theories, sheaves, session types, refinement calculus, hyperdoctrines, and evidence preservation with tree-sitter integration.
category:            Language
author:              Nadia
maintainer:          nadia@example.com
license:             EUPL-1.2
license-file:        LICENSE
build-type:          Simple

library
  exposed-modules:     Institution
                       FirstOrder
                       Equational
                       Sheaf
                       SessionTypes
                       RefinementCalculus
                       Hyperdoctrine
                       Evidence
                       Effect.Strand
                       Effect.Handlers
                       Effect.Rope
                       Persistence.Schema
                       Persistence.Beam
                       Persistence.Queries
                       Effect.Strand.Beam
                       Sandbox.Effect
                       Sandbox.Handler
                       Workflow.Synthesis
  other-modules:       Core.AST
                       CEGIS
                       Propositional
  build-depends:       base >=4.17 && <5
                     , containers
                     , hashable
                     , hs-tree-sitter
                     , tree-diff
                     , unordered-containers
                     , Folly
                     , jukebox
                     , crem
                     , text
                     , beam-core
                     , beam-sqlite
                     , sqlite-simple
                     , directory
                     , filepath
                     , process
                     , singletons-base
  hs-source-dirs:      packages/gargamelle/src
  default-language:    Haskell2010

test-suite tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:       base
                     , gargamelle
                     , hspec
                     , text
                     , beam-core
                     , beam-sqlite
                     , sqlite-simple
                     , crem
                     , directory
                     , filepath
                     , process
                     , tree-diff
  default-language:    Haskell2010